# Copy this file to `.env` (same directory) and fill in real values before running
# `docker compose up`. The real `.env` is gitignored — never commit it.

# Postgres / datasource credentials
DB_USERNAME=angleryst
DB_PASSWORD=change-me-to-a-strong-password

# JWT signing key — must be Base64-encoded and decode to at least 32 bytes (256 bits).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=generate-with-openssl-rand-base64-48
